#!/usr/bin/env bash

# Add a directory to the front of PATH, but only once.
prepend_path() {
  case ":${PATH}:" in
  *":$1:"*) ;; # already present, leave PATH alone
  *) PATH="$1${PATH:+:${PATH}}" ;;
  esac
}

# Last call ends up leftmost in PATH.
prepend_path "$HOME/bin"
prepend_path "$DOTS/bin"
prepend_path "$DOTS/tools/bin"
prepend_path "$HOME/.local/bin"

export PATH
unset -f prepend_path
