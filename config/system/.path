#!/usr/bin/env bash

# Add a directory to the front of PATH, but only once.
path_prepend() {
  case ":${PATH}:" in
  *":$1:"*) ;; # already present, leave PATH alone
  *) PATH="$1${PATH:+:${PATH}}" ;;
  esac
}

# Last call ends up leftmost in PATH.
path_prepend "$HOME/bin"
path_prepend "$DOTS/bin"
path_prepend "$DOTS/tools/bin"
path_prepend "$HOME/.local/bin"

export PATH
unset -f path_prepend
