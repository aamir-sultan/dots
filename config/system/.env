#!/usr/bin/env bash

# If nvim is not available then use vim as default editor.
# NOTE: was `[ ! -x "$(which nvim 2>/dev/null)" ]`. `which` is an external
# binary whose behaviour and exit status vary between distros (and it is not
# installed by default in minimal CentOS images); `command -v` is a shell
# builtin and is what the rest of these dotfiles already use.
if command -v nvim >/dev/null 2>&1; then
	export EDITOR=nvim
	export VISUAL=nvim
else
	export EDITOR=vim
	export VISUAL=vim
fi


export FZF_DEFAULT_COMMAND="find . -path '*/\.*' -type d -prune -o -type f -print -o -type l -print 2> /dev/null | sed s/^..//"