#!/usr/bin/env bash

# Upgrade TERM to its 256-colour variant, probing each entry before setting it.
# Must precede .colors, which bakes in the palette via `tput`: under TERM=xterm,
# `tput setaf 33` gives the invalid `\e[333m`, not `\e[38;5;33m`.
# Old GNOME Terminal announced its depth via COLORTERM instead of TERM.
if [[ $TERM == xterm && $COLORTERM == gnome-* ]] && infocmp gnome-256color >/dev/null 2>&1; then
  export TERM='gnome-256color'
elif [[ $TERM == xterm ]] && infocmp xterm-256color >/dev/null 2>&1; then
  export TERM='xterm-256color'
elif [[ $TERM == screen ]] && infocmp screen-256color >/dev/null 2>&1; then
  export TERM='screen-256color'
elif [[ $TERM == tmux ]] && infocmp tmux-256color >/dev/null 2>&1; then
  export TERM='tmux-256color'
fi

# Ignore duplicate commands in the history
export HISTCONTROL=ignoredups

# Increase the maximum number of lines contained in the history file
# (default is 500)
export HISTFILESIZE=1000000

# Increase the maximum number of commands to remember
# (default is 500)
export HISTSIZE=1000000

# Store timestamps alongside each command in the history file (~/.bash_history),
# allowing you to see when each command was executed.
export HISTTIMEFORMAT='%F %T '

# Ignore common commands
export HISTIGNORE='ls:ll:cd:pwd:clear:history'

