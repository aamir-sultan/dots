#!/usr/bin/env bash

# Ignore duplicate commands in the history
export HISTCONTROL=ignoredups

# Increase the maximum number of lines contained in the history file
# (default is 500)
export HISTFILESIZE=1000000

# Increase the maximum number of commands to remember
# (default is 500)
export HISTSIZE=1000000

# Store timestamps alongside each command in the history file (~/.bash_history),
# allowing you to see when each command was executed.
export HISTTIMEFORMAT='%F %T '

# Ignore common commands
export HISTIGNORE='ls:ll:cd:pwd:clear:history'

# Make new shells get the history lines from all previous shells instead of the
# default "last window closed" history. Guarded so re-sourcing (e.g. the `sb`
# alias) does not append another copy each time. Kept a string, not a bash 5.1+
# array, for CentOS 7's bash 4.2.
case ";${PROMPT_COMMAND};" in
*";__dots_prompt;"*) ;; # already installed
*) export PROMPT_COMMAND="__dots_prompt;${PROMPT_COMMAND}" ;;
esac

# Capturing $? must come first, before `history -a` clobbers it.
__dots_prompt() {
  __dots_status=$?
  history -a
  return $__dots_status
}

