#!/usr/bin/env bash

# Shell prompt based on the Solarized Dark theme.
# Screenshot: http://i.imgur.com/EkEtphC.png
# Heavily inspired by @necolas’s prompt: https://github.com/necolas/dotfiles

# TERM's 256-colour upgrade lives in .exports, which is sourced before .colors.

# ----------------------------------------------------------------------------------------
# Color setting of the different parts of the prompt based on the available terminal
# capabilities
# ----------------------------------------------------------------------------------------

# Abstraction layer for the colors between 8 bit terminals and tput supported 256 bit

if tput setaf 1 &>/dev/null; then
  # Text color variable.
  # textColor="${lYellow}"
  # textColor="${mustard3}"
  # textColor="${lGrey}"
  # textColor="${rBlack}"
  # textColor="${sBlue}"
  # textColor="${sCyan}"
  # textColor="${green3}"
  # textColor="${rRed}"
  # textColor="${reset}"
  # textColor="${sepia1}"
  # textColor="${sepia2}"
  # textColor="${dYellow}"
  # textColor="${blue1}"
  # textColor="${sBlue}"
  # textColor="${rCyan}"
  # textColor="${dOrange}"
  textColor="${dYellow}"
  # textColor="${blue}"
  # textColor="${dullGreen2}"
  # textColor="${dGreen}"
  # textColor="${lOrange}"
  # textColor="${dullGreen3}"
  # textColor="${sBlue}"

  # Symbol color variable.
  symbolColor="${sBlue}"
  # symbolColor="${dGreen}"
  # symbolColor="${sCyan}"
  # symbolColor="${lOrange}"
  # symbolColor="${dOrange}"
  # symbolColor="${lGrey}"
  errorColor="${rRed}"

  # Branch color variable.
  branchColor="${lOrange}"

  # Repo Status color variable.
  repoStatusColor="${sCyan}"

  # Word like at,in etc. color variable.
  # wordColor="${sWhite}"
  wordColor="${lGrey}"

  # Last command duration color variable. Muted, so it reads as a trailing note.
  durationColor="${lGrey}"

  # PWD color variable.
  pwdColor="${sBlue}"

  # User color variables
  userRootColor="${lRed}"
  # userNonRootColor="${rGreen}"
  userNonRootColor="${dGreen}"

  # SSH color variables
  hostSSHColor="${dYellow}"
  hostNonSSHColor="${dOrange}"
else
  # There is not much to do here in coloring cases. This is kind of fallback to 8-colors.
  # Orange is always mapped to Yellow as 8-colors donot have orange as such

  # Text color variable.
  textColor="${rYellow}"

  # Symbol color variable.
  symbolColor="${bWhite}"
  errorColor="${bRed}"

  # Branch color variable.
  branchColor="${bYellow}"

  # Repo Status color variable.
  repoStatusColor="${bCyan}"

  # PWD color variable.
  pwdColor="${bBlue}"

  # Word like at,in etc. color variable.
  wordColor="${bWhite}"

  # Last command duration color variable.
  durationColor="${rWhite}"

  # User color variables
  userRootColor="${bYellow}"
  userNonRootColor="${bGreen}"

  # SSH color variables
  hostSSHColor="${bRed}"
  hostNonSSHColor="${rYellow}"
fi

# ----------------------------------------------------------------------------------------
# Style setting of the different parts of the prompt based on context of terminal
# ----------------------------------------------------------------------------------------

# Highlight the user name when logged in as root.
if [[ "${USER}" == "root" ]]; then
  userStyle="${bold}${userRootColor}"
else
  userStyle="${bold}${userNonRootColor}"
fi

# Highlight the hostname when connected via SSH.
if [[ "${SSH_TTY}" ]]; then
  hostStyle="${bold}${hostSSHColor}"
else
  hostStyle="${bold}${hostNonSSHColor}"
fi

# `\D{...}` is re-expanded on every prompt so the clock ticks; a `$(date)`
# here would be evaluated once and frozen at login.
dateStyle='\D{Y%yM%mD%d %H:%M:%S}'

textStyle="${textColor}"
wordStyle="${wordColor}"
durationStyle="${durationColor}"
branchStyle="${branchColor}"
repoStatusStyle="${repoStatusColor}"
pwdStyle="${pwdColor}"

# Prompt Symbol Color
defaultSymbolStyle="${bold}${symbolColor}"
errorSymbolStyle="${bold}${errorColor}"

# ----------------------------------------------------------------------------------------
# Prompt functions for the handling last command status and git status
# ----------------------------------------------------------------------------------------

# Colour the prompt symbol red when the previous command failed. Must be a
# function called from PS1 via `\$(...)`: a plain variable would be expanded
# once at assignment and freeze. $? is captured by timer_prompt() below.
prompt_symbol_style() {
  if [ "${status:-0}" -ne 0 ] 2>/dev/null; then
    printf '%s' "${errorSymbolStyle}"
  else
    printf '%s' "${defaultSymbolStyle}"
  fi
}

# Prompt Symbol
# ❯, >, , », ⨔, ⌇, 󰘧, λ, λ:, ⁂, ➲, \$, \>
# promptSymbol=":>"
promptSymbol=">"
# promptSymbol="~>"
# promptSymbol="]>"

# Stamp the start of each command line. The trap fires per simple command, so the
# guard keeps the first of a pipeline; timer_prompt stops the clock and clears
# this. A bare Enter fires no trap, which is what clears the reading.
#
# Builtins only, no `date` fork: this runs before every command. EPOCHREALTIME is
# bash 5.0+ and comma-decimal in some locales; older bash gets whole seconds.
timer_start() {
  [[ -n ${timer+x} ]] && return
  local t=${EPOCHREALTIME:-$SECONDS.000000}
  timer=$((${t/[.,]/} / 1000))
}
trap 'timer_start' DEBUG

# Capturing $? must come first, before `history -a` clobbers it. Also stops the
# timer that trap started; an unset timer (a bare Enter) reads 0.
timer_prompt() {
  status=$?
  local t=${EPOCHREALTIME:-$SECONDS.000000}
  local now=$((${t/[.,]/} / 1000))
  elapsed_ms=$((now - ${timer:-$now}))
  unset timer
  history -a
  return $status
}

# Prepended so $? and the timer are read before anything else clobbers them, and
# guarded so re-sourcing (the `sb` alias) does not stack copies. Kept a string,
# not a bash 5.1+ array, for CentOS 7's bash 4.2.
case ";${PROMPT_COMMAND};" in
*";timer_prompt;"*) ;; # already installed
*) export PROMPT_COMMAND="timer_prompt;${PROMPT_COMMAND}" ;;
esac

# Report durations only at or above this, so `ls` and `cd` do not litter the
# prompt. Override in ~/.bash_prompt.local.
: "${PROMPT_MIN_MS:=1000}"

# How long the last command took. $1 is the colour prefix. Under the threshold
# prints nothing, which also swallows a negative from a manual `SECONDS=0`.
prompt_duration() {
  local ms=${elapsed_ms:-0}

  ((ms >= PROMPT_MIN_MS)) || return

  if ((ms < 60000)); then
    printf '%s%d.%ds' "$1" $((ms / 1000)) $((ms % 1000 / 100))
  elif ((ms < 3600000)); then
    printf '%s%dm%02ds' "$1" $((ms / 60000)) $((ms % 60000 / 1000))
  else
    printf '%s%dh%02dm' "$1" $((ms / 3600000)) $((ms % 3600000 / 60000))
  fi
}

prompt_git() {
  local s=''
  local branchName=''

  # Check if the current directory is in a Git repository.
  git rev-parse --is-inside-work-tree &>/dev/null || return

  # Check for what branch we’re on.
  # Get the short symbolic ref. If HEAD isn’t a symbolic ref, get a
  # tracking remote branch or tag. Otherwise, get the
  # short SHA for the latest commit, or give up.
  branchName="$(git symbolic-ref --quiet --short HEAD 2>/dev/null ||
    git describe --all --exact-match HEAD 2>/dev/null ||
    git rev-parse --short HEAD 2>/dev/null ||
    echo '(unknown)')"

  # Early exit for Chromium & Blink repo, as the dirty check takes too long.
  # Thanks, @paulirish!
  # https://github.com/paulirish/dotfiles/blob/dd33151f/.bash_prompt#L110-L123
  repoUrl="$(git config --get remote.origin.url)"
  if grep -q 'chromium/src.git' <<<"${repoUrl}"; then
    s+='*'
  else
    # Check for uncommitted changes in the index.
    if ! $(git diff --quiet --ignore-submodules --cached); then
      s+='+'
    fi
    # Check for unstaged changes.
    if ! $(git diff-files --quiet --ignore-submodules --); then
      s+='!'
    fi
    # Check for untracked files.
    if [ -n "$(git ls-files --others --exclude-standard)" ]; then
      s+='?'
    fi
    # Check for stashed files.
    if $(git rev-parse --verify refs/stash &>/dev/null); then
      s+='$'
    fi
  fi

  [ -n "${s}" ] && s=" [${s}]"

  echo -e "${1}${branchName}${2}${s}"
}

PS1="\n"                  # newline
PS1+="\[${userStyle}\]\u" # username
PS1+="\[${wordStyle}\] at "
PS1+="\[${hostStyle}\]\h (${dateStyle})"                                                    # host + live clock (\D{...})
PS1+="\[${wordStyle}\] in "
PS1+="\[${pwdStyle}\]\w"                                                                    # working directory full path
PS1+="\$(prompt_git \"\[${wordStyle}\] on \[${branchStyle}\]\" \"\[${repoStatusStyle}\]\")" # Git repository details
PS1+="\$(prompt_duration \"\[${wordStyle}\] took \[${durationStyle}\]\")"                   # last command run time
PS1+="\n"                                                                                   # newline after prompt and before symbol
PS1+="\[\$(prompt_symbol_style)\]${promptSymbol} \[${reset}\]"                              # prompt symbol, red on failure
PS1+="\[${textColor}\]"                                                                     # Terminal stdout color
export PS1

PS2="\[${rYellow}\]→ \[${reset}\]"
export PS2
