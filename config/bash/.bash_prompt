#!/usr/bin/env bash


# ----------------------------------------------------------------------------------------
# Color setting of the different parts of the prompt based on the available terminal
# capabilities
# ----------------------------------------------------------------------------------------

# Abstraction layer for the colors between 8 bit terminals and tput supported 256 bit.
if tput setaf 1 &>/dev/null; then
  text_color="${yellow_dark}"
  symbol_color="${blue_solarized}"
  error_color="${red_regular}"
  branch_color="${orange_light}"
  repo_status_color="${cyan_solarized}"
  word_color="${grey_light}"
  duration_color="${green_olive}"
  pwd_color="${blue_solarized}"
  user_color_root="${red_light}"
  user_color_nonroot="${green_dark}"
  host_color_remote="${yellow_dark}"
  host_color_local="${orange_dark}"
else
  # Fallback to 8 colors, where orange is always mapped to yellow as 8-colors do not
  # have orange as such.
  text_color="${yellow_regular}"
  symbol_color="${white_bold}"
  error_color="${red_bold}"
  branch_color="${yellow_bold}"
  repo_status_color="${cyan_bold}"
  pwd_color="${blue_bold}"
  word_color="${white_bold}"
  duration_color="${white_regular}"
  user_color_root="${yellow_bold}"
  user_color_nonroot="${green_bold}"
  host_color_remote="${red_bold}"
  host_color_local="${yellow_regular}"
fi

# ----------------------------------------------------------------------------------------
# Style setting of the different parts of the prompt based on context of terminal
# ----------------------------------------------------------------------------------------

if [[ "${USER}" == "root" ]]; then
  user_style="${bold}${user_color_root}"
else
  user_style="${bold}${user_color_nonroot}"
fi

if [[ "${SSH_TTY}" ]]; then
  host_style="${bold}${host_color_remote}"
else
  host_style="${bold}${host_color_local}"
fi

# `\D{...}` is re-expanded on every prompt so the clock ticks; a `$(date)`
# here would be evaluated once and frozen at login.
date_style='\D{Y%yM%mD%d %H:%M:%S}'

text_style="${text_color}"
word_style="${word_color}"
duration_style="${duration_color}"
branch_style="${branch_color}"
repo_status_style="${repo_status_color}"
pwd_style="${pwd_color}"

symbol_style_default="${bold}${symbol_color}"
symbol_style_error="${bold}${error_color}"

# ----------------------------------------------------------------------------------------
# Last command status, on every bash
# ----------------------------------------------------------------------------------------

# $? has to be read before anything else clobbers it, `history -a` right below included,
# and is handed back so a later hook still sees it.
prompt_status() {
  last_status=$?
  history -a
  return $last_status
}

# Prepended so nothing runs ahead of it, and guarded so re-sourcing (the `sb` alias) does
# not stack copies. Kept a string, not a bash 5.1+ array. Not exported: a child shell would
# inherit the name without the function behind it.
case ";${PROMPT_COMMAND};" in
*";prompt_status;"*) ;; # already installed
*) PROMPT_COMMAND="prompt_status;${PROMPT_COMMAND}" ;;
esac

# Colour the prompt symbol red when the previous command failed. Must be a function called
# from PS1 via `\$(...)`: a plain variable would be expanded once at assignment and freeze.
prompt_symbol_style() {
  if [ "${last_status:-0}" -ne 0 ] 2>/dev/null; then
    printf '%s' "${symbol_style_error}"
  else
    printf '%s' "${symbol_style_default}"
  fi
}

# Alternatives: ❯, >, , », ⨔, ⌇, 󰘧, λ, λ:, ⁂, ➲, \$, \>
prompt_symbol=">"

# ----------------------------------------------------------------------------------------
# Timing the last command, bash 5.0+ only
# ----------------------------------------------------------------------------------------
# PS0 arrived in bash 4.4 and EPOCHREALTIME in 5.0, so anything older gets no stamp, no
# hook, no threshold and no prompt_duration. The status above is unaffected either way.

if ((BASH_VERSINFO[0] >= 5)); then
  # PS0 is expanded once per command line, after the line is read and before it runs, which
  # is exactly where the clock should start. The assignment rides inside an array subscript
  # because a subscript is evaluated as arithmetic, while `_discard` itself stays unset so
  # the expansion prints nothing. EPOCHREALTIME is microseconds with a locale-dependent
  # decimal mark; dropping the mark and dividing gives milliseconds with no `date` fork.
  PS0='${_discard[$((timer_start_ms = ${EPOCHREALTIME/[.,]/} / 1000))]}'

  # Stops the clock PS0 started. No stamp means nothing to report, which is what a bare
  # Enter leaves behind, PS0 having never fired. $? is passed straight through, so this
  # hook cannot hide a failure from prompt_status.
  prompt_timer() {
    local rc=$?
    if [[ -n ${timer_start_ms+x} ]]; then
      timer_elapsed_ms=$((${EPOCHREALTIME/[.,]/} / 1000 - timer_start_ms))
      unset timer_start_ms
    else
      unset timer_elapsed_ms
    fi
    return $rc
  }

  # Ahead of prompt_status, so the clock is read before `history -a` charges its own write
  # to the command just finished.
  case ";${PROMPT_COMMAND};" in
  *";prompt_timer;"*) ;; # already installed
  *) PROMPT_COMMAND="prompt_timer;${PROMPT_COMMAND}" ;;
  esac

  # How long the last command took, as 2.0s, 2m05s or 1h30m. $1 is the colour prefix.
  # Anything under the threshold prints nothing, so `ls` and `cd` do not litter the prompt.
  # The threshold is read into a local with a fallback rather than assigned to a global, so
  # it exists only while this runs unless you set PROMPT_MIN_MS yourself in
  # ~/.bash_prompt.local, which is sourced after this file.
  prompt_duration() {
    local ms=${timer_elapsed_ms:-0}
    local min_ms=${PROMPT_MIN_MS:-1000}

    ((ms >= min_ms)) || return

    if ((ms < 60000)); then
      printf '%s%d.%ds' "$1" $((ms / 1000)) $((ms % 1000 / 100))
    elif ((ms < 3600000)); then
      printf '%s%dm%02ds' "$1" $((ms / 60000)) $((ms % 60000 / 1000))
    else
      printf '%s%dh%02dm' "$1" $((ms / 3600000)) $((ms % 3600000 / 60000))
    fi
  }
fi

# ----------------------------------------------------------------------------------------
# Git status
# ----------------------------------------------------------------------------------------

prompt_git() {
  local s=''
  local branchName=''

  git rev-parse --is-inside-work-tree &>/dev/null || return

  # The short symbolic ref. If HEAD isn’t a symbolic ref, a tracking remote branch or
  # tag. Otherwise the short SHA for the latest commit, or give up.
  branchName="$(git symbolic-ref --quiet --short HEAD 2>/dev/null ||
    git describe --all --exact-match HEAD 2>/dev/null ||
    git rev-parse --short HEAD 2>/dev/null ||
    echo '(unknown)')"

  # Walking the working tree is what costs time below, and in a very large repo it costs
  # enough to be felt at every prompt. Turn it off there with the same knob git's own
  # prompt honours, per repo or with --global:
  #   git config bash.showDirtyState false
  # '*' then means the state was not read, which is not the same as a clean tree.
  if [[ "$(git config --bool --get bash.showDirtyState)" == 'false' ]]; then
    s+='*'
  else
    # Uncommitted changes in the index.
    if ! $(git diff --quiet --ignore-submodules --cached); then
      s+='+'
    fi
    # Unstaged changes.
    if ! $(git diff-files --quiet --ignore-submodules --); then
      s+='!'
    fi
    # Untracked files.
    if [ -n "$(git ls-files --others --exclude-standard)" ]; then
      s+='?'
    fi
    # Stashed files.
    if $(git rev-parse --verify refs/stash &>/dev/null); then
      s+='$'
    fi
  fi

  [ -n "${s}" ] && s=" [${s}]"

  echo -e "${1}${branchName}${2}${s}"
}

# ----------------------------------------------------------------------------------------
# Prompt assembly
# ----------------------------------------------------------------------------------------

PS1="\n"                   # newline
PS1+="\[${user_style}\]\u" # username
PS1+="\[${word_style}\] at "
PS1+="\[${host_style}\]\h (${date_style})"                                                       # host + live clock (\D{...})
PS1+="\[${word_style}\] in "
PS1+="\[${pwd_style}\]\w"                                                                        # working directory full path
PS1+="\$(prompt_git \"\[${word_style}\] on \[${branch_style}\]\" \"\[${repo_status_style}\]\")"  # Git repository details
# Only where the timer above was installed; older bash has no prompt_duration to call.
((BASH_VERSINFO[0] >= 5)) &&
  PS1+="\$(prompt_duration \"\[${word_style}\] took \[${duration_style}\]\")"                    # last command run time
PS1+="\n"                                                                                        # newline after prompt and before symbol
PS1+="\[\$(prompt_symbol_style)\]${prompt_symbol} \[${reset}\]"                                  # prompt symbol, red on failure
PS1+="\[${text_color}\]"                                                                         # Terminal stdout color
export PS1

PS2="\[${yellow_regular}\]→ \[${reset}\]"
export PS2
