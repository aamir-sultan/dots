#!/usr/bin/env bash

# Most of the teminals support tput and it is the recommended way of doing it. There is a function which shows the alternative
# escape sequences for the colors. It is not recommended but for referance, it can be ran and get the result.

# Naming convention: <hue>_<variant>, so every shade of one hue sorts and tab-completes
# together — `orange_<TAB>` offers orange_light and orange_dark.
#
# In the 256-colour branch the variant picks a different colour index:
#   _solarized     -> the Solarized palette entry
#   _light/_dark   -> a lighter or darker take on the hue
#   _regular       -> the basic 8-colour entry
#
# In the 8-colour fallback the variant picks an SGR attribute instead:
#   _regular/_bold/_underline -> foreground carrying that attribute
#   _background               -> the hue as a background
#
# bold, italic and reset carry no hue, so they keep their plain names and compose with
# any colour: "${bold}${red_light}".

if tput setaf 1 &>/dev/null; then
  tput sgr0 # reset colors

  bold=$(tput bold)
  italic=$(tput sitm)
  reset=$(tput sgr0)

  # Solarized colors, taken from http://git.io/solarized-colors.
  black_solarized=$(tput setaf 0)
  blue_solarized=$(tput setaf 33)
  cyan_solarized=$(tput setaf 37)
  green_solarized=$(tput setaf 64)
  orange_solarized=$(tput setaf 166)
  purple_solarized=$(tput setaf 125)
  red_solarized=$(tput setaf 124)
  violet_solarized=$(tput setaf 61)
  white_solarized=$(tput setaf 15)
  yellow_solarized=$(tput setaf 136)

  black_regular=$(tput setaf 0)
  blue_regular=$(tput setaf 6)
  cyan_regular=$(tput setaf 4)
  green_regular=$(tput setaf 2)
  purple_regular=$(tput setaf 5)
  red_regular=$(tput setaf 1)
  white_regular=$(tput setaf 7)
  yellow_regular=$(tput setaf 3)

  green_light=$(tput setaf 118)
  red_light=$(tput setaf 196)
  yellow_light=$(tput setaf 227)
  orange_light=$(tput setaf 208)
  blue_light=$(tput setaf 69)
  grey_light=$(tput setaf 243)

  orange_dark=$(tput setaf 202)
  yellow_dark=$(tput setaf 214)
  green_dark=$(tput setaf 40)
  blue_dark=$(tput setaf 20)

  # Extra shades outside the Solarized set, named after their xterm-256 entry.
  yellow_gold=$(tput setaf 220)    # Gold1
  yellow_mustard=$(tput setaf 178) # LightGoldenrod3
  yellow_olive=$(tput setaf 100)   # Yellow4
  green_pale=$(tput setaf 119)     # LightGreen
  green_olive=$(tput setaf 106)    # DarkOliveGreen3
  cyan_dark=$(tput setaf 36)       # DarkCyan
  blue_sky=$(tput setaf 39)        # DeepSkyBlue1
  blue_deep=$(tput setaf 21)       # Blue1
  violet_bright=$(tput setaf 57)   # BlueViolet
  red_salmon=$(tput setaf 203)     # IndianRed1
  red_coral=$(tput setaf 210)      # LightCoral
  brown_dark=$(tput setaf 94)      # Orange4

else
  bold="\e[1m"
  italic="\e[3m"

  reset="\e[0m"

  black_bold="\e[1;30m"
  blue_bold="\e[1;34m"
  cyan_bold="\e[1;36m"
  green_bold="\e[1;32m"
  purple_bold="\e[1;35m"
  red_bold="\e[1;31m"
  white_bold="\e[1;37m"
  yellow_bold="\e[1;33m"

  # Other Variants, taken from https://unix.stackexchange.com/a/124409

  # Regular Colors
  black_regular="\e[0;30m"
  blue_regular="\e[0;34m"
  cyan_regular="\e[0;36m"
  green_regular="\e[0;32m"
  purple_regular="\e[0;35m"
  red_regular="\e[0;31m"
  white_regular="\e[0;37m"
  yellow_regular="\e[0;33m"

  # Underlined Style colors
  black_underline="\e[4;30m"
  blue_underline="\e[4;34m"
  cyan_underline="\e[4;36m"
  green_underline="\e[4;32m"
  purple_underline="\e[4;35m"
  red_underline="\e[4;31m"
  white_underline="\e[4;37m"
  yellow_underline="\e[4;33m"

  # Background Style colors
  black_background="\e[40m"
  blue_background="\e[44m"
  cyan_background="\e[46m"
  green_background="\e[42m"
  purple_background="\e[45m"
  red_background="\e[41m"
  white_background="\e[47m"
  yellow_background="\e[43m"
fi
