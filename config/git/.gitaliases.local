# Submodule and subtree workflow aliases. Only included on local (non-SSH)
# machines by init/configure-gitconfig.sh. Relies on helpers defined in
# .gitaliases (thisbr, thisremote, root, upbrexist).
#
# Subtree aliases read <repo-root>/.gittrees, one entry per line:
#   <prefix> <remote>

[alias]
    # ------------------------------------------------------------
    # Submodules
    # ------------------------------------------------------------
    sclone = clone --recurse-submodules
    supdate = submodule update --init
    sinit = submodule init
    ssync = submodule sync
    # Pull and update all submodules recursively
    mup = "!git pull --recurse-submodules && git submodule update --init --recursive"
    # Checkout main and pull
    main = "!git checkout main && git pull"
    # Pull, then move every submodule to latest main
    subsyncmain = "!git mup && git submodule foreach 'git checkout main && git pull origin main'"
    # Pull, move every submodule to latest main and stage the new pointers
    mlink = "!git mup && git submodule foreach 'git checkout main && git pull' && git add -u"

    # ------------------------------------------------------------
    # Subtrees (.gittrees)
    # ------------------------------------------------------------
    # Show .gittrees
    treelist = "!f() { t=\"$(git root)/.gittrees\"; [ -f \"$t\" ] && cat \"$t\"; }; f"
    # Dry run: print what would be pulled/pushed for each subtree
    treetest = "!f() { cd \"$(git root)\" || return; br=$(git thisbr) || return; [ -f .gittrees ] || return 0; while read -r p r _; do [ -n \"$r\" ] && echo \"$p $r $br\"; done < .gittrees; }; f"
    # Pull repo + subtrees from the current branch
    spull = "!f() { cd \"$(git root)\" && git mup && br=$(git thisbr) || return; [ -f .gittrees ] || return 0; while read -r p r _; do [ -n \"$r\" ] && { git subtree pull --prefix=\"$p\" \"$r\" \"$br\" || return; }; done < .gittrees; }; f"
    # Pull repo + subtrees from main
    spullm = "!f() { cd \"$(git root)\" && git mup || return; [ -f .gittrees ] || return 0; while read -r p r _; do [ -n \"$r\" ] && { git subtree pull --prefix=\"$p\" \"$r\" main || return; }; done < .gittrees; }; f"
    # Push repo, then subtrees to the current branch
    spush = "!f() { git push && cd \"$(git root)\" && br=$(git thisbr) || return; [ -f .gittrees ] || return 0; while read -r p r _; do [ -n \"$r\" ] && { git subtree push --prefix=\"$p\" \"$r\" \"$br\" || return; }; done < .gittrees; }; f"
    # Push repo, then subtrees to main
    spushm = "!f() { git push && cd \"$(git root)\" || return; [ -f .gittrees ] || return 0; while read -r p r _; do [ -n \"$r\" ] && { git subtree push --prefix=\"$p\" \"$r\" main || return; }; done < .gittrees; }; f"
    # Push each subtree with --rejoin (split+push in one step), then push the repo
    # (sets upstream if the branch is new on the remote)
    spushf = "!f() { cd \"$(git root)\" && rem=$(git thisremote) && br=$(git thisbr) || return; if [ -f .gittrees ]; then while read -r p r _; do [ -n \"$r\" ] || continue; git subtree push --annotate='(split) ' --rejoin --prefix=\"$p\" \"$r\" \"$br\" || return; done < .gittrees; fi; if git upbrexist >/dev/null 2>&1; then git push; else git push --set-upstream \"$rem\" \"$br\"; fi; }; f"
