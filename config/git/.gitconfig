# core.excludesfile is NOT set here. Unlike include.path, git resolves it
# against the current working directory rather than this file, so a relative
# value is silently inert; and it cannot be hardcoded because $DOTS is
# relocatable. init/configure-gitconfig.sh writes the absolute path into
# ~/.gitconfig at install time instead.
[core]
  # editor = /usr/bin/vim
  editor = $EDITOR

[init]
	defaultBranch = main

[credential]
# If you want to cache the credentials for some time (default 15 minutes)
	# helper = cache 
# if you want to store the credentials for ever (considered unsafe)
	helper = store

# Relative include paths ARE resolved against this file's directory.
[include]
  path = .gitaliases